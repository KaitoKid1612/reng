# Web: empty = /audio/kana, only public HTTPS base in production
NEXT_PUBLIC_AUDIO_BASE_URL=
# Script only; never prefix secret values with NEXT_PUBLIC_
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
AZURE_SPEECH_VOICE=ja-JP-NanamiNeural
# Chinese voices for npm run audio:generate; empty uses zh-CN-XiaoxiaoNeural / zh-TW-HsiaoChenNeural
AZURE_SPEECH_VOICE_ZH_CN=
AZURE_SPEECH_VOICE_ZH_TW=
# Script only: needed only with --voice unreal:<Haruto|Rina|Yuki|Hana|Sakura> (docs/06-audio.md)
UNREAL_SPEECH_API_KEY=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Lesson content source: local samples or published Supabase versions
LESSON_SOURCE=local
SUPABASE_PUBLISHABLE_KEY=
# Classes need SUPABASE_URL, SUPABASE_PUBLISHABLE_KEY and SUPABASE_SECRET_KEY (server only)
# "true" shows Google sign-in; enable the Google provider in Supabase Auth first (docs/poc-setup.md)
AUTH_GOOGLE_ENABLED=
# Public origin for email links, canonical URLs, sitemap and robots; empty uses the request host locally
SITE_URL=
# Search Console HTML-tag verification code (content value only); empty adds no tag
GOOGLE_SITE_VERIFICATION=
# Local stack only: password for teacher@reng.local created by npm run seed:local
SEED_TEACHER_PASSWORD=

# Reminder email (server only). EMAIL_PROVIDER=resend in hosted environments, mailpit locally.
EMAIL_PROVIDER=
EMAIL_FROM=Reng <nhacbai@example.com>
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
MAILPIT_URL=http://127.0.0.1:54324
# Random secrets: bearer for /api/cron/* and signing key for unsubscribe links
CRON_SECRET=
EMAIL_LINK_SECRET=
# Lesson audio (vocabulary, examples, listening): web base URL and the R2 upload base for scripts
NEXT_PUBLIC_LESSON_AUDIO_BASE_URL=
R2_LESSON_PUBLIC_BASE_URL=
