    "grammar": [
      {
        "id": "g3401",
        "pattern": "Vる／Vた + とおりに",
        "vi": "Làm đúng như lời nói hoặc mẫu",
        "explain": "Thể từ điển khi làm theo điều được nói hoặc làm làm mẫu. Thể た khi dựa vào điều đã nghe, thấy hoặc đã làm.",
        "viMistake": "Chọn みた とおりに cho điều đã nhìn thấy. Không thêm の sau động từ.",
        "examples": [
          {
            "jp": "{先生|せんせい}が {見|み}せた とおりに {紙|かみ}を {折|お}って ください。",
            "vi": "Hãy gấp giấy đúng như giáo viên đã làm mẫu.",
            "audio": null
          }
        ]
      },
      {
        "id": "g3402",
        "pattern": "Nの とおりに／Nどおりに",
        "vi": "Làm theo sơ đồ, hướng dẫn hoặc kế hoạch",
        "explain": "Dùng Nのとおりに. Một số danh từ ghép trực tiếp với どおりに, chẳng hạn せつめいしょどおりに.",
        "viMistake": "Dùng ずの とおりに hoặc ずどおりに.",
        "examples": [
          {
            "jp": "{図|ず}の とおりに {箱|はこ}を {組|く}み{立|た}てました。",
            "vi": "Tôi đã lắp hộp theo đúng sơ đồ.",
            "audio": null
          }
        ]
      },
      {
        "id": "g3403",
        "pattern": "Vた／Nの + あとで",
        "vi": "Làm việc sau một mốc",
        "explain": "Dùng V thể た hoặc N + の. Thể た ở vế đầu chỉ việc đó hoàn tất trước việc sau, kể cả khi cả hai chưa xảy ra.",
        "viMistake": "Dùng おわった あとで. Cũng có thể nói おわってから khi muốn lấy lúc xong làm mốc.",
        "examples": [
          {
            "jp": "{作業|さぎょう}が {終|お}わった あとで、{写真|しゃしん}を {撮|と}ります。",
            "vi": "Sau khi làm xong, tôi sẽ chụp ảnh.",
            "audio": null
          }
        ]
      },
      {
        "id": "g3404",
        "pattern": "V1て／V1ないで + V2",
        "vi": "Nói trạng thái đi kèm hành động chính",
        "explain": "V1 nói người thực hiện có làm hoặc không làm một việc đi kèm khi thực hiện V2.",
        "viMistake": "Muốn nói không chấm nước tương thì dùng つけないで. つけなくて thường nối theo quan hệ khác, như nguyên nhân.",
        "examples": [
          {
            "jp": "{醤油|しょうゆ}を つけないで {食|た}べます。",
            "vi": "Tôi ăn mà không chấm nước tương.",
            "audio": null
          },
          {
            "jp": "シートベルトを して {車|くるま}に {乗|の}って います。",
            "vi": "Tôi đang ngồi trong xe và có thắt dây an toàn.",
            "audio": null
          }
        ]
      },
      {
        "id": "g3405",
        "pattern": "V1ないで、V2",
        "vi": "Chọn làm V2 thay cho V1",
        "explain": "Dùng V1 thể ない + で, rồi nêu việc làm thay thế ở V2.",
        "viMistake": "Cùng là ないで. Dựa vào ngữ cảnh để biết thiếu hành động đi kèm hay chọn việc khác.",
        "examples": [
          {
            "jp": "バスに {乗|の}らないで、{駅|えき}まで {歩|ある}きました。",
            "vi": "Tôi đi bộ đến ga thay vì đi xe buýt.",
            "audio": null
          }
        ]
      }
    ],
