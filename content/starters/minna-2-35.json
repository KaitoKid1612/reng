    "grammar": [
      {
        "id": "g3501",
        "pattern": "Vば／Vなければ",
        "vi": "Nêu điều kiện với động từ",
        "explain": "Nhóm I đổi âm cuối sang hàng え + ば. Nhóm II bỏ る, thêm れば. する → すれば, くる → くれば. Phủ định: bỏ い của thể ない rồi thêm ければ.",
        "viMistake": "よむ → よめば, よまない → よまなければ. Khi cả hai vế cùng chủ thể và vế điều kiện là hành động chủ ý, thường chọn たら để nối sang lời mời hoặc yêu cầu.",
        "examples": [
          {
            "jp": "この レバーを {引|ひ}けば、ドアが {開|あ}きます。",
            "vi": "Nếu kéo cần gạt này thì cửa sẽ mở.",
            "audio": null
          }
        ]
      },
      {
        "id": "g3502",
        "pattern": "Aければ／Aなら",
        "vi": "Nêu điều kiện với tính từ",
        "explain": "Tính từ い bỏ い, thêm ければ. いい → よければ. Tính từ な có thể dùng なら. Dạng phủ định dùng 〜くなければ hoặc 〜じゃなければ.",
        "viMistake": "やすい → やすければ. しずか → しずかなら.",
        "examples": [
          {
            "jp": "{天気|てんき}が よければ、{屋上|おくじょう}から {島|しま}が {見|み}えます。",
            "vi": "Nếu thời tiết tốt, từ sân thượng sẽ nhìn thấy đảo.",
            "audio": null
          }
        ]
      },
      {
        "id": "g3503",
        "pattern": "Nなら／それなら",
        "vi": "Đưa gợi ý dựa vào chủ đề vừa nêu",
        "explain": "N + なら đưa một chủ đề ra để gợi ý. それなら tiếp nhận cả tình huống người đối thoại vừa nói.",
        "viMistake": "Danh từ đứng trực tiếp trước なら: やまのぼりなら.",
        "examples": [
          {
            "jp": "{山登|やまのぼ}りなら、{近所|きんじょ}の {山|やま}が いいですよ。",
            "vi": "Nếu muốn leo núi thì ngọn núi gần đây hay đấy.",
            "audio": null
          }
        ]
      },
      {
        "id": "g3504",
        "pattern": "疑問詞 + Vば いいですか",
        "vi": "Hỏi nên làm gì, ở đâu hoặc thế nào",
        "explain": "Chọn từ để hỏi theo thông tin cần biết rồi chia động từ sang thể điều kiện. Liên hệ 〜たらいいですか ở bài 26.",
        "viMistake": "Hỏi nơi mua vé dùng どこで, không dùng どこに.",
        "examples": [
          {
            "jp": "この {欄|らん}には {何|なに}を {入力|にゅうりょく}すれば いいですか。",
            "vi": "Tôi nên nhập gì vào ô này?",
            "audio": null
          }
        ]
      },
      {
        "id": "g3505",
        "pattern": "〜ば 〜ほど",
        "vi": "Nói mức độ tăng theo nhau",
        "explain": "Vば + V từ điển + ほど, hoặc Aければ + Aい + ほど. Lặp cùng từ. Mục này dùng để luyện mở rộng.",
        "viMistake": "ほど sau số lượng cũng có thể nghĩa là khoảng, chẳng hạn 10分ほど.",
        "examples": [
          {
            "jp": "{歩|ある}けば {歩|ある}くほど、{港|みなと}が {近|ちか}く なります。",
            "vi": "Càng đi bộ thì càng đến gần cảng.",
            "audio": null
          }
        ]
      }
    ],
