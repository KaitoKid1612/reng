    "grammar": [
      {
        "id": "g3001",
        "pattern": "場所に Nが Vてあります",
        "vi": "Tả thứ được đặt sẵn ở đâu",
        "explain": "Nơi chốn + に + N が + tha động từ thể て + あります. Tả kết quả còn thấy sau một hành động có chủ ý.",
        "viMistake": "まどが あいて います chỉ cửa đang mở. まどが あけて あります gợi ý có người mở và để vậy.",
        "examples": [
          {
            "jp": "{入口|いりぐち}に お{知|し}らせが {貼|は}って あります。",
            "vi": "Ở lối vào có dán sẵn thông báo.",
            "audio": null
          }
        ]
      },
      {
        "id": "g3002",
        "pattern": "Nは 場所に Vてあります",
        "vi": "Nói vật đã được để ở đâu",
        "explain": "Đưa vật lên làm chủ đề bằng は, rồi nêu nơi cất, đặt hoặc treo. V ở thể て và là tha động từ.",
        "viMistake": "Nói vị trí thì dùng に, chẳng hạn ひきだしに.",
        "examples": [
          {
            "jp": "{予備|よび}の {鍵|かぎ}は {引|ひ}き{出|だ}しに しまって あります。",
            "vi": "Chìa khóa dự phòng đã được cất trong ngăn kéo.",
            "audio": null
          }
        ]
      },
      {
        "id": "g3003",
        "pattern": "Vておきます · Chuẩn bị",
        "vi": "Làm trước để dùng sau",
        "explain": "Dùng thể て + おきます. Nêu việc mình định làm trước một sự kiện. Khi nhờ, dùng Vておいてください.",
        "viMistake": "Chọn ならべて おきます khi nói việc sẽ làm. Chọn ならべて あります khi tả kết quả đã có.",
        "examples": [
          {
            "jp": "{講義|こうぎ}の {前|まえ}に {椅子|いす}を {並|なら}べて おきます。",
            "vi": "Tôi sẽ xếp ghế sẵn trước buổi giảng.",
            "audio": null
          }
        ]
      },
      {
        "id": "g3004",
        "pattern": "Vておきます · Thu dọn",
        "vi": "Xử lý sau khi dùng để tiện lần sau",
        "explain": "Dùng 〜たら hoặc 〜たあとで để nêu mốc rồi dùng Vておきます cho việc thu dọn, cất hoặc trả lại.",
        "viMistake": "Khác với chuẩn bị trước, ở đây việc dọn diễn ra sau hoạt động chính.",
        "examples": [
          {
            "jp": "{道具|どうぐ}を {使|つか}ったら、{元|もと}の {所|ところ}に {戻|もど}して おいて ください。",
            "vi": "Dùng dụng cụ xong thì để lại chỗ cũ giúp tôi.",
            "audio": null
          }
        ]
      },
      {
        "id": "g3005",
        "pattern": "Vておきます · Giữ nguyên",
        "vi": "Để trạng thái tiếp tục",
        "explain": "Dùng Vておきます cho trạng thái muốn duy trì. Có thể dùng そのままにします để nói cứ để nguyên.",
        "viMistake": "Muốn để cửa mở thì dùng あけて おきます. Muốn để cửa đóng thì dùng しめて おきます.",
        "examples": [
          {
            "jp": "{風|かぜ}が {通|とお}るように、ドアを {開|あ}けて おきます。",
            "vi": "Tôi sẽ để cửa mở cho thoáng.",
            "audio": null
          }
        ]
      },
      {
        "id": "g3006",
        "pattern": "まだ Vています",
        "vi": "Nói việc hoặc trạng thái vẫn tiếp diễn",
        "explain": "まだ đi với Vています để nói vẫn còn. まだ Vていません nói việc đến lúc này vẫn chưa xảy ra.",
        "viMistake": "まだ ならべて います nghĩa là vẫn đang xếp, còn まだ ならべて いません nghĩa là chưa xếp.",
        "examples": [
          {
            "jp": "{隣|となり}の {部屋|へや}では まだ ミーティングを して います。",
            "vi": "Phòng bên vẫn đang họp.",
            "audio": null
          }
        ]
      },
      {
        "id": "g3007",
        "pattern": "Nとか、Nとか",
        "vi": "Nêu vài ví dụ trong một nhóm",
        "explain": "Dùng とか để kể vài thứ làm ví dụ. Danh sách có thể còn những mục khác.",
        "viMistake": "Trong yêu cầu chính thức, có thể gặp や hoặc など. とか thường dùng trong hội thoại.",
        "examples": [
          {
            "jp": "リュックには {水|みず}とか {懐中電灯|かいちゅうでんとう}とかを {入|い}れます。",
            "vi": "Tôi bỏ vào ba lô những thứ như nước và đèn pin.",
            "audio": null
          }
        ]
      }
    ],
