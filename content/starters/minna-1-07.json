    "grammar": [
      {
        "id": "g0701",
        "pattern": "N (công cụ) で V",
        "vi": "Làm V bằng N",
        "explain": "で chỉ công cụ, phương tiện: はしで {食|た}べます, パソコンで {書|か}きます. Hỏi: {何|なに}で V ますか.",
        "viMistake": "Công cụ dùng で, không dùng を: はしで {食|た}べます, không nói はしを {食|た}べます.",
        "examples": [
          {
            "jp": "はしで ご{飯|はん}を {食|た}べます。",
            "vi": "Tôi ăn cơm bằng đũa.",
            "audio": null
          },
          {
            "jp": "パソコンで レポートを {書|か}きます。",
            "vi": "Tôi viết báo cáo bằng máy tính.",
            "audio": null
          },
          {
            "jp": "{何|なに}で {写真|しゃしん}を {撮|と}りましたか。…ケータイで {撮|と}りました。",
            "vi": "Bạn chụp ảnh bằng gì? … Bằng điện thoại.",
            "audio": null
          }
        ]
      },
      {
        "id": "g0702",
        "pattern": "「từ」は 〜語で なんですか",
        "vi": "Từ … tiếng … là gì?",
        "explain": "Hỏi cách nói một từ trong ngôn ngữ khác: 「Cảm ơn」は {日本語|にほんご}で {何|なん}ですか → 「ありがとう」です. で ở đây là \"bằng (ngôn ngữ)\": {日本語|にほんご}で {書|か}きます.",
        "examples": [
          {
            "jp": "「Thank you」は {日本語|にほんご}で {何|なん}ですか。…「ありがとう」です。",
            "vi": "\"Thank you\" tiếng Nhật là gì? … Là \"arigatou\".",
            "audio": null
          },
          {
            "jp": "「さようなら」は ベトナム{語|ご}で {何|なん}ですか。…「Tạm biệt」です。",
            "vi": "\"Sayounara\" tiếng Việt là gì? … Là \"Tạm biệt\".",
            "audio": null
          },
          {
            "jp": "{日本語|にほんご}で メールを {書|か}きます。",
            "vi": "Tôi viết email bằng tiếng Nhật.",
            "audio": null
          }
        ]
      },
      {
        "id": "g0703",
        "pattern": "N1 (người) に N2 を あげます／かします／おしえます",
        "vi": "Cho / cho mượn / dạy N2 cho N1",
        "explain": "に đứng sau người nhận. Các động từ trao đi: あげます (cho, tặng), {貸|か}します (cho mượn), {教|おし}えます (dạy), {送|おく}ります (gửi), でんわを かけます (gọi điện).",
        "viMistake": "Người khác cho mình thì không dùng あげます; dùng もらいます (mẫu tiếp theo).",
        "examples": [
          {
            "jp": "{友達|ともだち}に {花|はな}を あげました。",
            "vi": "Tôi đã tặng hoa cho bạn.",
            "audio": null
          },
          {
            "jp": "アンさんに {本|ほん}を {貸|か}します。",
            "vi": "Tôi cho An mượn sách.",
            "audio": null
          },
          {
            "jp": "{家族|かぞく}に メールを {送|おく}ります。",
            "vi": "Tôi gửi email cho gia đình.",
            "audio": null
          }
        ]
      },
      {
        "id": "g0704",
        "pattern": "N1 (người) に N2 を もらいます／かります／ならいます",
        "vi": "Nhận / mượn / học N2 từ N1",
        "explain": "に đứng sau người cho (người mình nhận từ đó). Các động từ nhận về: もらいます (nhận), {借|か}ります (mượn), {習|なら}います (học).",
        "viMistake": "Người cho đứng trước に: {先生|せんせい}に {日本語|にほんご}を {習|なら}います là học tiếng Nhật với thầy cô.",
        "examples": [
          {
            "jp": "{母|はは}に シャツを もらいました。",
            "vi": "Tôi đã nhận áo sơ mi từ mẹ.",
            "audio": null
          },
          {
            "jp": "{友達|ともだち}に お{金|かね}を {借|か}りました。",
            "vi": "Tôi đã mượn tiền của bạn.",
            "audio": null
          },
          {
            "jp": "{田中|たなか}さんに {日本語|にほんご}を {習|なら}います。",
            "vi": "Tôi học tiếng Nhật với anh Tanaka.",
            "audio": null
          }
        ]
      },
      {
        "id": "g0705",
        "pattern": "もう V ました／まだです",
        "vi": "Đã V rồi / chưa",
        "explain": "Hỏi việc đã xong chưa: もう V ましたか. Trả lời: はい、もう V ました hoặc いいえ、まだです.",
        "viMistake": "\"Chưa\" là いいえ、まだです; いいえ、V ませんでした có nghĩa là đã không làm.",
        "examples": [
          {
            "jp": "もう {昼|ひる}ご{飯|はん}を {食|た}べましたか。…はい、もう {食|た}べました。",
            "vi": "Bạn đã ăn trưa chưa? … Rồi, mình ăn rồi.",
            "audio": null
          },
          {
            "jp": "もう {宿題|しゅくだい}を しましたか。…いいえ、まだです。",
            "vi": "Em đã làm bài tập chưa? … Dạ, chưa ạ.",
            "audio": null
          },
          {
            "jp": "もう {荷物|にもつ}を {送|おく}りましたか。…いいえ、まだです。これから {送|おく}ります。",
            "vi": "Bạn đã gửi hành lý chưa? … Chưa. Bây giờ mình gửi.",
            "audio": null
          }
        ]
      }
    ],
