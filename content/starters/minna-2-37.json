      {
        "id": "s3730",
        "type": "dialogue",
        "title": "Hội thoại · Hỏi về phòng trưng bày",
        "reveal": true,
        "lines": [
          {
            "speaker": "An",
            "jp": "この {建物|たてもの}は いつ {建|た}てられましたか。",
            "vi": "Tòa nhà này được xây khi nào ạ?"
          },
          {
            "speaker": "Mai",
            "jp": "およそ １００{年|ねん}{前|まえ}です。{地元|じもと}の {建築家|けんちくか}によって {設計|せっけい}されました。",
            "vi": "Khoảng 100 năm trước. Một kiến trúc sư địa phương đã thiết kế."
