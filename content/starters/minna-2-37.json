    "grammar": [
      {
        "id": "g3701",
        "pattern": "Thể bị động · 受身形",
        "vi": "Đổi động từ sang thể bị động",
        "explain": "Nhóm I đổi âm cuối sang hàng あ + れる, riêng う → われる. Nhóm II bỏ る, thêm られる. する → される, くる → こられる.",
        "viMistake": "Nhóm I: ふむ → ふまれる. Nhóm II có dạng られる trùng thể khả năng, nên xem trợ từ và ngữ cảnh.",
        "examples": [
          {
            "jp": "{名前|なまえ}を {呼|よ}ばれました。",
            "vi": "Tôi được gọi tên.",
            "audio": null
          }
        ]
      },
      {
        "id": "g3702",
        "pattern": "N1 は N2 に V bị động",
        "vi": "Nói từ góc nhìn của người nhận tác động",
        "explain": "N1 nhận tác động. N2 thực hiện, đi với に. Tùy ngữ cảnh tiếng Việt có thể dịch là được hoặc bị.",
        "viMistake": "Câu chủ động せんせいが わたしを ほめました đổi thành わたしは せんせいに ほめられました.",
        "examples": [
          {
            "jp": "{試合|しあい}の あとで、コーチに {褒|ほ}められました。",
            "vi": "Sau trận đấu, tôi được huấn luyện viên khen.",
            "audio": null
          }
        ]
      },
      {
        "id": "g3703",
        "pattern": "N1 は N2 に N3 を V bị động",
        "vi": "Nêu người chịu ảnh hưởng qua đồ vật hoặc bộ phận",
        "explain": "Giữ N3 với を. Chủ đề N1 là người chịu ảnh hưởng, N2 là người tác động.",
        "viMistake": "Đặt người chịu ảnh hưởng làm chủ đề khi kể chuyện xảy ra với đồ của mình.",
        "examples": [
          {
            "jp": "わたしは {弟|おとうと}に {自転車|じてんしゃ}を {壊|こわ}されました。",
            "vi": "Tôi bị em trai làm hỏng xe đạp.",
            "audio": null
          }
        ]
      },
      {
        "id": "g3704",
        "pattern": "Sự vật が／は + V bị động",
        "vi": "Giới thiệu sự kiện, công trình hoặc sản phẩm",
        "explain": "Dùng が để nêu sự kiện, は để lấy sự vật đang nói tới làm chủ đề. Có thể lược người thực hiện. 〜られています mô tả trạng thái hoặc hoạt động đang duy trì.",
        "viMistake": "Không cần thêm tác nhân nếu trọng tâm là nơi, thời gian hay kết quả.",
        "examples": [
          {
            "jp": "{来月|らいげつ}、{港|みなと}で {展覧会|てんらんかい}が {開|ひら}かれます。",
            "vi": "Tháng sau một triển lãm sẽ được tổ chức ở cảng.",
            "audio": null
          }
        ]
      },
      {
        "id": "g3705",
        "pattern": "N によって + V bị động",
        "vi": "Nêu người tạo ra tác phẩm hoặc công trình",
        "explain": "Dùng によって khi cần nêu tác giả, người thiết kế hoặc người phát minh trong câu giới thiệu khách quan.",
        "viMistake": "に vẫn thường gặp khi kể về người trực tiếp tác động tới mình.",
        "examples": [
          {
            "jp": "この {建物|たてもの}は {地元|じもと}の {建築家|けんちくか}によって {設計|せっけい}されました。",
            "vi": "Tòa nhà này do một kiến trúc sư địa phương thiết kế.",
            "audio": null
          }
        ]
      },
      {
        "id": "g3706",
        "pattern": "N から／N で 作られます",
        "vi": "Nói nguyên liệu hoặc vật liệu",
        "explain": "から thường nêu nguyên liệu đã qua biến đổi. で thường nêu vật liệu còn nhận ra được trong thành phẩm.",
        "viMistake": "Gỗ trong bàn vẫn nhận ra được, nên dùng きで つくられます.",
        "examples": [
          {
            "jp": "この パンは {小麦|こむぎ}から {作|つく}られています。",
            "vi": "Bánh mì này được làm từ lúa mì.",
            "audio": null
          }
        ]
      }
    ],
