    "grammar": [
      {
        "id": "g1001",
        "pattern": "N が あります／います",
        "vi": "Có N",
        "explain": "あります dùng cho đồ vật, cây cối, nơi chốn (thứ không tự di chuyển). います dùng cho người và động vật.",
        "viMistake": "Người và con vật dùng います: いぬが います. Đồ vật dùng あります: {電池|でんち}が あります.",
        "examples": [
          {
            "jp": "{電池|でんち}が ありますか。…はい、あります。",
            "vi": "Có pin không? … Có.",
            "audio": null
          },
          {
            "jp": "{男|おとこ}の {子|こ}が います。",
            "vi": "Có một cậu bé.",
            "audio": null
          },
          {
            "jp": "いぬが いますか。…いいえ、いません。",
            "vi": "Có con chó nào không? … Không có.",
            "audio": null
          }
        ]
      },
      {
        "id": "g1002",
        "pattern": "N1 (nơi chốn) に N2 が あります／います",
        "vi": "Ở N1 có N2",
        "explain": "に đứng sau nơi tồn tại; が đánh dấu thứ mới được nhắc tới. Hỏi: N1 に {何|なに}が ありますか／だれが いますか.",
        "examples": [
          {
            "jp": "あそこに コンビニが あります。",
            "vi": "Ở đằng kia có cửa hàng tiện lợi.",
            "audio": null
          },
          {
            "jp": "{部屋|へや}に だれが いますか。…{田中|たなか}さんが います。",
            "vi": "Trong phòng có ai? … Có anh Tanaka.",
            "audio": null
          },
          {
            "jp": "ハノイに ホアンキエム{湖|こ}が あります。",
            "vi": "Ở Hà Nội có hồ Hoàn Kiếm.",
            "audio": null
          }
        ]
      },
      {
        "id": "g1003",
        "pattern": "N2 は N1 (nơi chốn) に あります／います",
        "vi": "N2 ở N1",
        "explain": "Nói vị trí của thứ đã biết: N2 làm chủ đề (は), nơi chốn + に. Hỏi: N2 は どこに ありますか → N1 に あります. Có thể rút gọn như bài 3: N2 は N1 です.",
        "viMistake": "Hỏi vị trí thứ đã biết dùng は (トイレは どこに ありますか); giới thiệu thứ mới dùng が (あそこに トイレが あります).",
        "examples": [
          {
            "jp": "{田中|たなか}さんは {会議室|かいぎしつ}に います。",
            "vi": "Anh Tanaka ở phòng họp.",
            "audio": null
          },
          {
            "jp": "{電池|でんち}は どこに ありますか。…{箱|はこ}の {中|なか}に あります。",
            "vi": "Pin ở đâu? … Ở trong hộp.",
            "audio": null
          },
          {
            "jp": "ヌクマムは どこに ありますか。…あの コーナーに あります。",
            "vi": "Nước mắm ở đâu? … Ở quầy kia.",
            "audio": null
          }
        ]
      },
      {
        "id": "g1004",
        "pattern": "N の うえ／した／まえ／うしろ／なか／となり／ちかく",
        "vi": "Trên / dưới / trước / sau / trong / bên cạnh / gần N",
        "explain": "N + の + từ chỉ vị trí + に: テーブルの {上|うえ}に. Ở giữa hai nơi: N1 と N2 の {間|あいだ}.",
        "viMistake": "Thứ tự ngược tiếng Việt: \"trên bàn\" là テーブルの {上|うえ} (bàn trước, trên sau).",
        "examples": [
          {
            "jp": "テーブルの {上|うえ}に {本|ほん}が あります。",
            "vi": "Trên bàn có quyển sách.",
            "audio": null
          },
          {
            "jp": "{銀行|ぎんこう}は {郵便局|ゆうびんきょく}の となりに あります。",
            "vi": "Ngân hàng ở bên cạnh bưu điện.",
            "audio": null
          },
          {
            "jp": "{駅|えき}と {公園|こうえん}の {間|あいだ}に コンビニが あります。",
            "vi": "Giữa nhà ga và công viên có cửa hàng tiện lợi.",
            "audio": null
          }
        ]
      },
      {
        "id": "g1005",
        "pattern": "N1 や N2［など］",
        "vi": "N1, N2 và … (liệt kê tiêu biểu)",
        "explain": "や liệt kê vài thứ tiêu biểu, ngầm hiểu còn thứ khác; thêm など ở cuối (v.v.). と thì liệt kê đủ hết.",
        "viMistake": "と liệt kê đủ hết; や chỉ nêu vài thứ tiêu biểu.",
        "examples": [
          {
            "jp": "{箱|はこ}の {中|なか}に {手紙|てがみ}や {写真|しゃしん}が あります。",
            "vi": "Trong hộp có thư, ảnh, …",
            "audio": null
          },
          {
            "jp": "{冷蔵庫|れいぞうこ}に {卵|たまご}や {牛乳|ぎゅうにゅう}などが あります。",
            "vi": "Trong tủ lạnh có trứng, sữa, v.v.",
