    "grammar": [
      {
        "id": "g0601",
        "pattern": "N を V ます",
        "vi": "Làm V (với đối tượng N)",
        "explain": "を đánh dấu đối tượng của động từ: ăn cái gì, uống cái gì, đọc cái gì. Hỏi: {何|なに}を しますか／{何|なに}を {食|た}べますか.",
        "viMistake": "を viết bằng chữ を nhưng đọc là お.",
        "examples": [
          {
            "jp": "{毎朝|まいあさ} パンを {食|た}べます。",
            "vi": "Sáng nào tôi cũng ăn bánh mì.",
            "audio": null
          },
          {
            "jp": "{何|なに}を {飲|の}みますか。…お{茶|ちゃ}を {飲|の}みます。",
            "vi": "Bạn uống gì? … Tôi uống trà.",
            "audio": null
          },
          {
            "jp": "きのう {手紙|てがみ}を {書|か}きました。",
            "vi": "Hôm qua tôi đã viết thư.",
            "audio": null
          }
        ]
      },
      {
        "id": "g0602",
        "pattern": "なにも V ません",
        "vi": "Không V gì cả",
        "explain": "{何|なに}も + động từ phủ định: hoàn toàn không (giống どこも ở bài 5). Hỏi {何|なに}を しましたか, trả lời {何|なに}も しませんでした.",
        "viMistake": "{何|なに}も luôn đi với phủ định; không nói {何|なに}も {食|た}べます.",
        "examples": [
          {
            "jp": "けさ {何|なに}も {食|た}べませんでした。",
            "vi": "Sáng nay tôi không ăn gì cả.",
            "audio": null
          },
          {
            "jp": "{日曜日|にちようび} {何|なに}を しましたか。…{何|なに}も しませんでした。",
            "vi": "Chủ nhật bạn đã làm gì? … Tôi không làm gì cả.",
            "audio": null
          },
          {
            "jp": "{店|みせ}で {何|なに}も {買|か}いませんでした。",
            "vi": "Tôi không mua gì ở cửa hàng.",
            "audio": null
          }
        ]
      },
      {
        "id": "g0603",
        "pattern": "N (nơi chốn) で V ます",
        "vi": "Làm V ở N",
        "explain": "で đứng sau nơi diễn ra hành động. Khác へ: へ là nơi đến (デパートへ {行|い}きます), で là nơi làm việc gì đó (デパートで {買|か}います). Hỏi: どこで V ますか.",
        "viMistake": "Đừng dùng へ cho nơi làm hành động: {図書館|としょかん}で {勉強|べんきょう}します, không nói {図書館|としょかん}へ {勉強|べんきょう}します.",
        "examples": [
          {
            "jp": "デパートで {靴|くつ}を {買|か}いました。",
            "vi": "Tôi đã mua giày ở cửa hàng bách hóa.",
            "audio": null
          },
          {
            "jp": "{図書館|としょかん}で {勉強|べんきょう}します。",
            "vi": "Tôi học ở thư viện.",
            "audio": null
          },
          {
            "jp": "どこで その {写真|しゃしん}を {撮|と}りましたか。…ダナンで {撮|と}りました。",
            "vi": "Bạn chụp bức ảnh đó ở đâu? … Ở Đà Nẵng.",
            "audio": null
          }
        ]
      },
      {
        "id": "g0604",
        "pattern": "V ませんか",
        "vi": "Cùng … không? (lời mời)",
        "explain": "Mời người khác cùng làm: いっしょに + V ませんか. Đồng ý: ええ、いいですね. Từ chối nhẹ: すみません、ちょっと….",
        "viMistake": "V ませんか là lời mời lịch sự, không phải câu hỏi \"bạn không làm à?\".",
        "examples": [
          {
            "jp": "いっしょに {昼|ひる}ご{飯|はん}を {食|た}べませんか。…ええ、いいですね。",
            "vi": "Cùng ăn trưa không? … Ừ, hay đấy.",
            "audio": null
          },
          {
            "jp": "{土曜日|どようび} テニスを しませんか。…{土曜日|どようび}は ちょっと…。",
            "vi": "Thứ Bảy chơi tennis không? … Thứ Bảy thì hơi…",
            "audio": null
          },
          {
            "jp": "{日曜日|にちようび} いっしょに {美術館|びじゅつかん}へ {行|い}きませんか。",
            "vi": "Chủ nhật cùng đi bảo tàng mỹ thuật không?",
            "audio": null
          }
        ]
      },
      {
        "id": "g0605",
        "pattern": "V ましょう",
        "vi": "Cùng … nhé (đề nghị)",
        "explain": "Đề nghị cùng làm, hoặc đáp lại lời mời: V ましょう. Hỏi ý kiến về chỗ, giờ: どこで {会|あ}いましょうか, {何時|なんじ}に {会|あ}いましょうか.",
        "viMistake": "Khi được mời ませんか và muốn đồng ý, đáp ええ、V ましょう.",
        "examples": [
          {
            "jp": "ちょっと {休|やす}みましょう。",
            "vi": "Nghỉ một chút nhé.",
            "audio": null
          },
          {
            "jp": "どこで {会|あ}いましょうか。…{駅|えき}で {会|あ}いましょう。",
            "vi": "Mình gặp nhau ở đâu nhỉ? … Gặp ở ga nhé.",
            "audio": null
          },
          {
            "jp": "{何時|なんじ}に {会|あ}いましょうか。…10{時|じ}に {会|あ}いましょう。",
            "vi": "Mấy giờ gặp nhau nhỉ? … 10 giờ nhé.",
            "audio": null
          }
        ]
      }
    ],
    "slides": [
      {
        "id": "s0601",
        "teacherNotes": "Khởi động: hỏi bằng tiếng Việt \"sáng nay bạn ăn gì, uống gì?\". Bài đi theo trình tự bài 6 Minna no Nihongo Sơ cấp I.",
        "type": "title",
        "jp": "{第|だい}6{課|か}",
        "vi": "Ăn uống, hoạt động và lời mời: いっしょに いきませんか"
      },
      {
        "id": "s0602",
        "type": "note",
        "title": "Mục tiêu buổi học",
        "body": "1. Nói việc làm với đối tượng: N を V ます\n2. Không làm gì cả: なにも V ません\n3. Nơi làm hành động: N で V ます\n4. Mời: V ませんか; đề nghị: V ましょう; đồng ý và từ chối nhẹ"
      },
