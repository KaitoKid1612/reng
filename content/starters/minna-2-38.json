    "grammar": [
      {
        "id": "g3801",
        "pattern": "Vる + のは + tính từ",
        "vi": "Nhận xét về một hành động",
        "explain": "Thêm の vào cụm động từ để biến cả cụm thành chủ đề, rồi dùng は trước phần nhận xét.",
        "viMistake": "Dùng は để nhận xét hành động. Dùng が trong mẫu sở thích ở slide sau.",
        "examples": [
          {
            "jp": "{海岸|かいがん}を {歩|ある}く のは {気持|きも}ちが いいです。",
            "vi": "Đi dạo dọc bờ biển rất dễ chịu.",
            "audio": null
          }
        ]
      },
      {
        "id": "g3802",
        "pattern": "Vる + のが + tính từ",
        "vi": "Nói thích, giỏi hoặc đánh giá tốc độ",
        "explain": "Dùng のが trước すき, きらい, じょうず, へた, hoặc はやい, おそい khi đánh giá việc làm.",
        "viMistake": "Dùng りょうりを する のが すきです. を đi với する trong cụm, còn が đi sau の.",
        "examples": [
          {
            "jp": "{弟|おとうと}は {花|はな}を {育|そだ}てる のが {好|す}きです。",
            "vi": "Em trai tôi thích trồng hoa.",
            "audio": null
          }
        ]
      },
      {
        "id": "g3803",
        "pattern": "Vる + のを忘れました",
        "vi": "Nói quên làm một việc",
        "explain": "Đặt việc lẽ ra phải làm trước のを忘れました. Động từ ở dạng từ điển.",
        "viMistake": "かぎを かける のを わすれました là quên khóa, còn かぎを わすれました là quên chìa khóa.",
        "examples": [
          {
            "jp": "{研究室|けんきゅうしつ}の {電源|でんげん}を {切|き}る のを {忘|わす}れました。",
            "vi": "Tôi quên tắt nguồn điện ở phòng nghiên cứu.",
            "audio": null
          }
        ]
      },
      {
        "id": "g3804",
        "pattern": "普通形 + のを知っていますか",
        "vi": "Hỏi người nghe có biết một sự việc không",
        "explain": "Đặt sự việc trước のを知っていますか. Khi trả lời chưa biết tin vừa nghe, có thể nói 知りませんでした.",
        "viMistake": "Dùng ひらいた のを nếu sự việc mở cửa đã xảy ra, dùng ひらく のを nếu đó là kế hoạch.",
        "examples": [
          {
            "jp": "{駅前|えきまえ}に {新|あたら}しい {店|みせ}が できた のを {知|し}って いますか。",
            "vi": "Bạn có biết trước ga mới có một cửa hàng không?",
            "audio": null
          }
        ]
      },
      {
        "id": "g3805",
        "pattern": "〜のは Nです",
        "vi": "Nhấn mạnh người, nơi hoặc thời điểm",
        "explain": "Đưa sự việc lên trước のは. Đặt thông tin muốn làm nổi bật sau は.",
        "viMistake": "Nơi xảy ra sự việc có thể đứng cuối: うまれた のは この むらです.",
        "examples": [
          {
            "jp": "わたしが この {村|むら}に {来|き}た のは {一昨年|おととし}です。",
            "vi": "Tôi đến làng này vào năm kia.",
            "audio": null
          }
        ]
      }
    ],
