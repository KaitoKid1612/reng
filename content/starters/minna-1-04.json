        "refs": ["v0441", "v0442", "v0443", "v0444", "v0445", "v0446", "v0447", "v0448"]
      },
      {
        "id": "s0409",
        "teacherNotes": "Học viên đọc giờ trước rồi bấm mũi tên để kiểm tra. Nhấn mạnh 4時, 7時, 9時.",
        "type": "table",
