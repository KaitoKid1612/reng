    "grammar": [
      {
        "id": "g0401",
        "pattern": "いま 〜じ 〜ふん です",
        "vi": "Bây giờ là … giờ … phút",
        "explain": "Giờ: số + {時|じ}; phút: số + {分|ふん} hoặc {分|ぷん} tùy số. 30 phút nói {半|はん}. Hỏi: いま {何時|なんじ}ですか. Có thể thêm {午前|ごぜん} (sáng) hoặc {午後|ごご} (chiều) trước giờ.",
        "viMistake": "4 giờ là よじ (không nói よんじ), 9 giờ là くじ, 7 giờ là しちじ. Phút: 1 いっぷん, 3 さんぷん, 6 ろっぷん, 8 はっぷん, 10 じゅっぷん.",
        "examples": [
          {
            "jp": "いま {何時|なんじ}ですか。…9{時|じ}{半|はん}です。",
            "vi": "Bây giờ là mấy giờ? … 9 giờ rưỡi.",
            "audio": null
          },
          {
            "jp": "ハノイは いま {午後|ごご}3{時|じ}です。",
            "vi": "Ở Hà Nội bây giờ là 3 giờ chiều.",
            "audio": null
          },
          {
            "jp": "{東京|とうきょう}は いま {午後|ごご}5{時|じ}10{分|ぷん}です。",
            "vi": "Ở Tokyo bây giờ là 5 giờ 10 phút chiều.",
            "audio": null
          }
        ]
      },
      {
        "id": "g0402",
        "pattern": "V ます／V ません",
        "vi": "Làm / không làm (thói quen, việc sẽ làm)",
        "explain": "Động từ thể ます nói thói quen hoặc việc sẽ làm. Phủ định: ます → ません. Hỏi: V ますか → はい、V ます／いいえ、V ません.",
        "viMistake": "Câu hỏi có động từ thì trả lời bằng động từ: はい、{働|はたら}きます, không trả lời はい、そうです.",
        "examples": [
          {
            "jp": "{毎日|まいにち} {勉強|べんきょう}します。",
            "vi": "Ngày nào tôi cũng học.",
            "audio": null
          },
          {
            "jp": "あした {働|はたら}きますか。…いいえ、{働|はたら}きません。",
            "vi": "Ngày mai bạn có làm việc không? … Không, tôi không làm.",
            "audio": null
          },
          {
            "jp": "{日曜日|にちようび} {休|やす}みます。",
            "vi": "Chủ nhật tôi nghỉ.",
            "audio": null
          }
        ]
      },
      {
        "id": "g0403",
        "pattern": "V ました／V ませんでした",
        "vi": "Đã làm / đã không làm (quá khứ)",
        "explain": "Quá khứ: ます → ました. Phủ định quá khứ: ません → ませんでした. Dùng với từ chỉ quá khứ như きのう, けさ.",
        "viMistake": "Có きのう, けさ thì động từ phải ở dạng ました／ませんでした, không dùng ます.",
        "examples": [
          {
            "jp": "きのう {勉強|べんきょう}しました。",
            "vi": "Hôm qua tôi đã học.",
            "audio": null
          },
          {
            "jp": "きのう {働|はたら}きましたか。…いいえ、{働|はたら}きませんでした。",
            "vi": "Hôm qua bạn có làm việc không? … Không, tôi đã không làm.",
            "audio": null
          },
          {
            "jp": "{試験|しけん}は きのう {終|お}わりました。",
            "vi": "Kỳ thi đã kết thúc hôm qua.",
            "audio": null
          }
        ]
      },
      {
        "id": "g0404",
        "pattern": "〜じ に V ます",
        "vi": "Làm V lúc … giờ",
        "explain": "Thời điểm có số (giờ, thứ, ngày) + に + động từ. Từ chỉ thời gian tương đối như きょう, あした, まいあさ, いま không đi với に.",
        "viMistake": "Không nói あしたに, まいにちに, いまに. Chỉ thời điểm có số như 6{時|じ}に mới thêm に.",
        "examples": [
          {
            "jp": "{毎朝|まいあさ} 6{時|じ}に {起|お}きます。",
            "vi": "Mỗi sáng tôi dậy lúc 6 giờ.",
            "audio": null
          },
          {
            "jp": "{毎晩|まいばん} 11{時|じ}に {寝|ね}ます。",
            "vi": "Mỗi tối tôi đi ngủ lúc 11 giờ.",
            "audio": null
          },
          {
            "jp": "{会議|かいぎ}は 2{時|じ}に {始|はじ}まります。",
            "vi": "Cuộc họp bắt đầu lúc 2 giờ.",
            "audio": null
          }
        ]
      },
      {
        "id": "g0405",
        "pattern": "N1 から N2 まで",
        "vi": "Từ N1 đến N2",
        "explain": "から (từ) và まで (đến) đứng sau mốc thời gian. Giờ mở cửa: N は 〜から 〜までです. Hai danh từ nối bằng と: {土曜日|どようび}と {日曜日|にちようび}.",
        "viMistake": "Thứ tự ngược tiếng Việt: \"từ 9 giờ\" là 9{時|じ}から, \"đến 5 giờ\" là 5{時|じ}まで.",
        "examples": [
          {
            "jp": "9{時|じ}から 5{時|じ}まで {働|はたら}きます。",
            "vi": "Tôi làm việc từ 9 giờ đến 5 giờ.",
            "audio": null
          },
          {
            "jp": "{郵便局|ゆうびんきょく}は {何時|なんじ}から {何時|なんじ}までですか。…8{時|じ}から 7{時|じ}までです。",
            "vi": "Bưu điện mở cửa từ mấy giờ đến mấy giờ? … Từ 8 giờ đến 7 giờ.",
            "audio": null
          },
          {
            "jp": "{休|やす}みは {土曜日|どようび}と {日曜日|にちようび}です。",
            "vi": "Ngày nghỉ là thứ Bảy và Chủ nhật.",
            "audio": null
          }
        ]
      }
    ],
    "slides": [
      {
        "id": "s0401",
        "teacherNotes": "Khởi động: chỉ đồng hồ trong lớp và hỏi bằng tiếng Việt \"bây giờ mấy giờ?\", \"mỗi sáng mấy giờ bạn dậy?\". Bài đi theo trình tự bài 4 Minna no Nihongo Sơ cấp I.",
        "type": "title",
        "jp": "{第|だい}4{課|か}",
        "vi": "Giờ giấc và sinh hoạt: いま なんじですか"
      },
      {
        "id": "s0402",
        "type": "note",
        "title": "Mục tiêu buổi học",
        "body": "1. Hỏi và nói giờ: いま なんじですか\n2. Nói thói quen và việc sẽ làm: V ます／V ません\n3. Kể việc đã làm: V ました／V ませんでした\n4. Thời điểm 〜じに, khoảng thời gian 〜から 〜まで, thứ trong tuần"
      },
      {
        "id": "s0403",
        "teacherNotes": "Diễn tả bằng động tác: vươn vai (おきます), ngả đầu (ねます), gõ bàn phím (はたらきます).",
        "type": "vocab",
        "refs": ["v0401", "v0402", "v0403", "v0404", "v0405", "v0406", "v0407", "v0408"]
      },
      {
        "id": "s0404",
        "teacherNotes": "Quay kim đồng hồ giấy và cho học viên đọc giờ.",
        "type": "vocab",
        "refs": ["v0409", "v0410", "v0411", "v0412", "v0413", "v0414", "v0415", "v0416"]
      },
      {
        "id": "s0405",
        "teacherNotes": "ごぜん／ごご đứng trước giờ: ごぜん 9じ, ごご 3じ.",
        "type": "vocab",
        "refs": ["v0417", "v0418", "v0419", "v0420", "v0421", "v0422", "v0423", "v0424"]
      },
      {
        "id": "s0406",
        "teacherNotes": "毎 + thời điểm = mỗi …: まいあさ, まいばん, まいにち.",
        "type": "vocab",
        "refs": ["v0425", "v0426", "v0427", "v0428", "v0429", "v0430", "v0431", "v0432"]
      },
      {
        "id": "s0407",
        "teacherNotes": "Thứ trong tuần: học theo nhóm ngày (月 trăng, 火 lửa, 水 nước, 木 cây, 金 vàng, 土 đất, 日 mặt trời).",
