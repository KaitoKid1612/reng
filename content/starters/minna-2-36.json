    "grammar": [
      {
        "id": "g3601",
        "pattern": "Vる／Vない + ように、V2",
        "vi": "Làm V2 để đạt hoặc tránh một kết quả",
        "explain": "Đặt mục tiêu trước ように, rồi nói việc làm để đạt mục tiêu. Vế đầu hay dùng thể khả năng, động từ chỉ trạng thái hoặc thể ない.",
        "viMistake": "はなせる ように là để nói được. わすれない ように là để không quên.",
        "examples": [
          {
            "jp": "{日本語|にほんご}で メールが {打|う}てる ように、{毎週|まいしゅう} {練習|れんしゅう}して います。",
            "vi": "Tôi luyện mỗi tuần để có thể gõ email bằng tiếng Nhật.",
            "audio": null
          },
          {
            "jp": "{忘|わす}れない ように、{予定|よてい}を メモします。",
            "vi": "Tôi ghi lại lịch để không quên.",
            "audio": null
          }
        ]
      },
      {
        "id": "g3602",
        "pattern": "Vる + ようになります",
        "vi": "Trở nên làm được hoặc bắt đầu làm thường xuyên",
        "explain": "Dùng thể khả năng để nói thay đổi năng lực, hoặc thể từ điển để nói hành vi mới. Dùng 〜なくなります để diễn tả không còn làm hoặc không còn làm được.",
        "viMistake": "およげるようになりました là đã bơi được. およがなくなりました nghĩa là không còn bơi nữa.",
        "examples": [
          {
            "jp": "やっと {長|なが}い {文|ぶん}が {読|よ}める ように なりました。",
            "vi": "Cuối cùng tôi đã đọc được câu dài.",
            "audio": null
          }
        ]
      },
      {
        "id": "g3603",
        "pattern": "Vる／Vない + ようにしています",
        "vi": "Chủ động cố duy trì thói quen",
        "explain": "Dùng thể từ điển hoặc ない. ようにします nói sẽ cố thực hiện; ようにしています nhấn việc vẫn đang duy trì.",
        "viMistake": "ようになりました nêu thay đổi đã xảy ra. ようにしています nêu việc đang cố thực hiện.",
        "examples": [
          {
            "jp": "できるだけ ９{時|じ}を {過|す}ぎてから メールを {送|おく}らない ように して います。",
            "vi": "Tôi cố hạn chế gửi email sau 9 giờ.",
            "audio": null
          }
        ]
      },
      {
        "id": "g3604",
        "pattern": "Vる／Vない + ようにしてください",
        "vi": "Nhắc người khác cố thực hiện",
        "explain": "Dùng để nhắc chú ý duy trì một việc hoặc tránh làm. Sắc thái tùy ngữ cảnh và quan hệ.",
        "viMistake": "Đừng quên dùng わすれない ように してください.",
        "examples": [
          {
            "jp": "{毎月|まいつき}、{記録|きろく}を {確認|かくにん}する ように して ください。",
            "vi": "Hãy nhớ kiểm tra ghi chép mỗi tháng.",
            "audio": null
          }
        ]
      }
    ],
