    "grammar": [
      {
        "id": "g3201",
        "pattern": "Vた／Vない + ほうがいいです",
        "vi": "Nên làm hoặc nên tránh",
        "explain": "Lời khuyên cụ thể: V thể た khi khuyên làm, V thể ない khi khuyên tránh. よ ở cuối câu có thể nhấn lời khuyên.",
        "viMistake": "Vた trong mẫu này không chỉ thời quá khứ. Muốn khuyên đừng đi thì dùng いかない.",
        "examples": [
          {
            "jp": "{道|みち}が {込|こ}みますから、{早|はや}く {出|で}た ほうが いいです。",
            "vi": "Đường sẽ đông, nên đi sớm.",
            "audio": null
          }
        ]
      },
      {
        "id": "g3202",
        "pattern": "普通形 + でしょう",
        "vi": "Đưa ra dự đoán",
        "explain": "Dùng thể thường trước でしょう. Danh từ và tính từ な ở hiện tại khẳng định bỏ だ. Hay gặp trong bản tin dự báo.",
        "viMistake": "Dùng しずかでしょう. Với quá khứ vẫn giữ だった: しずかだったでしょう.",
        "examples": [
          {
            "jp": "{夕方|ゆうがた}には {雨|あめ}が やむでしょう。",
            "vi": "Có lẽ đến chiều muộn mưa sẽ tạnh.",
            "audio": null
          }
        ]
      },
      {
        "id": "g3203",
        "pattern": "普通形 + かもしれません",
        "vi": "Nêu khả năng còn chưa chắc",
        "explain": "Dùng thể thường. Bỏ だ với danh từ và tính từ な ở hiện tại khẳng định. Có thể mở đầu bằng もしかしたら.",
        "viMistake": "Dùng あめかもしれません. Giữ dạng phủ định trong こないかもしれません.",
        "examples": [
          {
            "jp": "もしかしたら、{試合|しあい}に {間|ま}に {合|あ}わないかもしれません。",
            "vi": "Có thể tôi sẽ không kịp đến trận đấu.",
            "audio": null
          }
        ]
      }
    ],
