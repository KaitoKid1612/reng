        "id": "s4428",
        "type": "dialogue",
        "title": "Nghe · Sau tiệc tất niên",
        "reveal": true,
        "lines": [
          {
            "speaker": "An",
            "jp": "{顔色|かおいろ}が {悪|わる}いですね。どうしたんですか。",
            "vi": "Sắc mặt anh kém quá. Có chuyện gì vậy?"
          },
          {
            "speaker": "Minh",
            "jp": "ゆうべの {忘年会|ぼうねんかい}で {飲|の}みすぎたんです。",
            "vi": "Tối qua tôi uống quá nhiều ở tiệc tất niên."
          },
          {
            "speaker": "An",
