        "reveal": true,
        "lines": [
          {
            "speaker": "Thợ cắt tóc",
            "jp": "いらっしゃいませ。どう なさいますか。",
            "vi": "Kính chào quý khách. Quý khách muốn làm gì ạ?"
          },
          {
            "speaker": "Nam",
            "jp": "カットを お{願|ねが}いします。",
            "vi": "Cắt tóc giúp tôi."
          },
          {
            "speaker": "Thợ cắt tóc",
            "jp": "どういう ふうに なさいますか。",
            "vi": "Quý khách muốn cắt kiểu thế nào ạ?"
          },
          {
            "speaker": "Nam",
            "jp": "{横|よこ}を {短|みじか}く して、{前|まえ}は あまり {切|き}らないで ください。",
            "vi": "Cắt ngắn hai bên, phía trước đừng cắt nhiều."
          },
          {
            "speaker": "Thợ cắt tóc",
            "jp": "{長|なが}さは これで よろしいでしょうか。",
            "vi": "Độ dài thế này được chưa ạ?"
          },
          {
            "speaker": "Nam",
            "jp": "{前|まえ}が ちょっと {長|なが}すぎます。もう {少|すこ}し {短|みじか}く して ください。",
            "vi": "Phía trước hơi dài quá. Cắt ngắn thêm chút nữa giúp tôi."
          }
        ],
        "teacherNotes": "Đọc trước khi chiếu. Hỏi: Nam muốn cắt thế nào? Lúc cuối Nam nhờ sửa gì?"
      },
