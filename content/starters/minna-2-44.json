    "grammar": [
      {
        "id": "g4401",
        "pattern": "Vます／いA／なA + すぎます",
        "vi": "Quá mức, quá …",
        "explain": "Động từ bỏ ます, いA bỏ い, なA giữ nguyên gốc rồi thêm すぎます. Chia như động từ nhóm 2: すぎて, すぎた. Thường mang ý không tốt.",
        "viMistake": "いい → よすぎます. Muốn khen thì dùng とても, không dùng すぎます.",
        "examples": [
          {
            "jp": "{昨日|きのう} {食|た}べすぎて、おなかが {痛|いた}いです。",
            "vi": "Hôm qua ăn quá nhiều nên tôi đau bụng.",
            "audio": null
          },
          {
            "jp": "{説明|せつめい}が {複雑|ふくざつ}すぎて、わかりません。",
            "vi": "Lời giải thích phức tạp quá nên tôi không hiểu.",
            "audio": null
          }
        ]
      },
      {
        "id": "g4402",
        "pattern": "Vます + やすい／にくい",
        "vi": "Dễ / khó làm, dễ / khó xảy ra",
        "explain": "Với hành động có chủ ý: dễ làm, khó làm (かきやすい). Với động từ không chủ ý (sự việc tự xảy ra): dễ xảy ra, khó xảy ra (われやすい, かわきにくい). Chia như tính từ い.",
        "viMistake": "〜やすい này khác 安い (rẻ). Phủ định: かきやすく ないです.",
        "examples": [
          {
            "jp": "この ペンは {軽|かる}くて、{書|か}きやすいです。",
            "vi": "Cây bút này nhẹ nên dễ viết.",
            "audio": null
          },
          {
            "jp": "{厚|あつ}い タオルは {乾|かわ}きにくいです。",
            "vi": "Khăn dày khó khô.",
            "audio": null
          }
        ]
      },
      {
        "id": "g4403",
        "pattern": "いAく／なAに／Nに + します",
        "vi": "Làm cho trở nên …",
        "explain": "Ai đó chủ động thay đổi trạng thái của vật. So sánh: なります (bài 19) là tự thay đổi, します là có người làm cho thay đổi.",
        "viMistake": "Vật bị thay đổi đi với を: へやを きれいに します. へやが きれいに なりました là tự nó sạch.",
        "examples": [
          {
            "jp": "テレビの {音|おと}を {小|ちい}さく して ください。",
            "vi": "Hãy vặn nhỏ tiếng tivi.",
            "audio": null
          },
          {
            "jp": "{部屋|へや}を きれいに しました。",
            "vi": "Tôi đã dọn phòng sạch sẽ.",
            "audio": null
          }
        ]
      },
      {
        "id": "g4404",
        "pattern": "N + に します",
        "vi": "Chọn, quyết định lấy N",
        "explain": "Dùng khi gọi món, chọn đồ, chọn ngày giờ.",
        "viMistake": "Hỏi chọn: 〜と 〜と どちらに しますか. Trả lời: 〜に します.",
        "examples": [
          {
            "jp": "わたしは {和食|わしょく}に します。",
            "vi": "Tôi chọn món Nhật.",
            "audio": null
          },
          {
            "jp": "{部屋|へや}は ツインに します。",
            "vi": "Phòng thì tôi lấy phòng hai giường.",
            "audio": null
          }
        ]
      }
    ],
