    "grammar": [
      {
        "id": "g0501",
        "pattern": "N (nơi chốn) へ 行きます／来ます／帰ります",
        "vi": "Đi / đến / về N",
        "explain": "へ chỉ hướng đi, đứng sau nơi chốn. {行|い}きます: đi; {来|き}ます: đến (chỗ người nói); {帰|かえ}ります: về nhà, về nước. Hỏi: どこへ {行|い}きますか.",
        "viMistake": "Trợ từ へ viết bằng chữ へ nhưng đọc là え.",
        "examples": [
          {
            "jp": "あした {銀行|ぎんこう}へ {行|い}きます。",
            "vi": "Ngày mai tôi đi ngân hàng.",
            "audio": null
          },
          {
            "jp": "{田中|たなか}さんは {来月|らいげつ} ハノイへ {来|き}ます。",
            "vi": "Tháng sau anh Tanaka sẽ đến Hà Nội.",
            "audio": null
          },
          {
            "jp": "きのう 6{時|じ}に うちへ {帰|かえ}りました。",
            "vi": "Hôm qua tôi về nhà lúc 6 giờ.",
            "audio": null
          }
        ]
      },
      {
        "id": "g0502",
        "pattern": "どこ（へ）も 行きません",
        "vi": "Không đi đâu cả",
        "explain": "Từ để hỏi + も + động từ phủ định: hoàn toàn không. Hỏi どこへ {行|い}きましたか, trả lời どこも {行|い}きませんでした (hoặc どこへも).",
        "viMistake": "どこも luôn đi với động từ phủ định: không nói どこも {行|い}きます.",
        "examples": [
          {
            "jp": "{日曜日|にちようび} どこへ {行|い}きましたか。…どこも {行|い}きませんでした。",
            "vi": "Chủ nhật bạn đã đi đâu? … Tôi không đi đâu cả.",
            "audio": null
          },
          {
            "jp": "あした どこへも {行|い}きません。",
            "vi": "Ngày mai tôi không đi đâu cả.",
            "audio": null
          },
          {
            "jp": "{今週|こんしゅう}は どこも {行|い}きません。",
            "vi": "Tuần này tôi không đi đâu cả.",
            "audio": null
          }
        ]
      },
      {
        "id": "g0503",
        "pattern": "N (phương tiện) で 行きます",
        "vi": "Đi bằng N",
        "explain": "で đứng sau phương tiện. Đi bộ là {歩|ある}いて, không có で. Hỏi: {何|なん}で {行|い}きますか (đi bằng gì).",
        "viMistake": "Không nói あるいてで; chỉ nói {歩|ある}いて {行|い}きます.",
        "examples": [
          {
            "jp": "{電車|でんしゃ}で {会社|かいしゃ}へ {行|い}きます。",
            "vi": "Tôi đi làm bằng tàu điện.",
            "audio": null
          },
          {
            "jp": "{何|なん}で {学校|がっこう}へ {来|き}ましたか。…バイクで {来|き}ました。",
            "vi": "Bạn đến trường bằng gì? … Tôi đến bằng xe máy.",
            "audio": null
          },
          {
            "jp": "{駅|えき}から {歩|ある}いて {帰|かえ}りました。",
            "vi": "Tôi đi bộ từ ga về.",
            "audio": null
          }
        ]
      },
      {
        "id": "g0504",
        "pattern": "N (người) と 行きます・一人で",
        "vi": "Đi cùng N / đi một mình",
        "explain": "と đứng sau người đi cùng. Đi một mình là {一人|ひとり}で, không có と. Hỏi: だれと {行|い}きますか.",
        "viMistake": "Không nói {一人|ひとり}と; một mình là {一人|ひとり}で.",
        "examples": [
          {
            "jp": "{友達|ともだち}と {美術館|びじゅつかん}へ {行|い}きます。",
            "vi": "Tôi đi bảo tàng mỹ thuật với bạn.",
            "audio": null
          },
          {
            "jp": "だれと {日本|にほん}へ {来|き}ましたか。…{家族|かぞく}と {来|き}ました。",
            "vi": "Bạn đến Nhật cùng ai? … Tôi đến cùng gia đình.",
            "audio": null
          },
          {
            "jp": "{一人|ひとり}で うちへ {帰|かえ}ります。",
            "vi": "Tôi về nhà một mình.",
            "audio": null
          }
        ]
      },
      {
        "id": "g0505",
        "pattern": "いつ・〜月〜日",
        "vi": "Khi nào; ngày … tháng …",
        "explain": "Hỏi thời điểm: いつ (không thêm に). Ngày tháng: tháng trước, ngày sau: 〜{月|がつ}〜{日|にち}. Ngày 1–10, 14, 20, 24 có cách đọc riêng: ついたち, ふつか, みっか, よっか, いつか, むいか, なのか, ようか, ここのか, とおか, じゅうよっか, はつか, にじゅうよっか.",
        "viMistake": "Tiếng Nhật nói tháng trước ngày sau: 3{月|がつ}{5日|いつか} là ngày 5 tháng 3. Tháng 4, 7, 9 đọc しがつ, しちがつ, くがつ.",
        "examples": [
          {
            "jp": "いつ {日本|にほん}へ {行|い}きますか。…{来月|らいげつ} {行|い}きます。",
            "vi": "Khi nào bạn đi Nhật? … Tháng sau tôi đi.",
            "audio": null
          },
          {
            "jp": "{誕生日|たんじょうび}は いつですか。…7{月|がつ}{10日|とおか}です。",
            "vi": "Sinh nhật bạn là khi nào? … Ngày 10 tháng 7.",
            "audio": null
          },
          {
            "jp": "9{月|がつ}{1日|ついたち}に ハノイへ {来|き}ました。",
            "vi": "Tôi đã đến Hà Nội vào ngày 1 tháng 9.",
            "audio": null
          }
        ]
      }
    ],
    "slides": [
      {
        "id": "s0501",
        "teacherNotes": "Khởi động: hỏi bằng tiếng Việt \"cuối tuần bạn đi đâu, bằng gì, với ai?\". Bài đi theo trình tự bài 5 Minna no Nihongo Sơ cấp I.",
        "type": "title",
        "jp": "{第|だい}5{課|か}",
        "vi": "Đi lại: どこへ いきますか"
      },
      {
        "id": "s0502",
        "type": "note",
        "title": "Mục tiêu buổi học",
        "body": "1. Nói nơi đi, đến, về: 〜へ 行きます／来ます／帰ります\n2. Nói phương tiện 〜で và người đi cùng 〜と, một mình ひとりで\n3. Không đi đâu cả: どこも 行きません\n4. Hỏi khi nào いつ, nói ngày tháng 〜月〜日"
      },
      {
        "id": "s0503",
        "teacherNotes": "Ba động từ chuyển động: いきます (đi khỏi chỗ mình), きます (đến chỗ mình), かえります (về nhà, về nước).",
        "type": "vocab",
