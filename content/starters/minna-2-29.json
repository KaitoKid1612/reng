    "grammar": [
      {
        "id": "g2901",
        "pattern": "N が 自動詞て います",
        "vi": "Tả trạng thái sau một thay đổi",
        "explain": "N が + tự động từ thể て + います. Tả đồ vật hiện ra sao sau khi nó thay đổi.",
        "viMistake": "ドアが あいて います tả trạng thái. ドアを あけます nói việc ai đó mở cửa.",
        "examples": [
          {
            "jp": "{玄関|げんかん}の ドアが {閉|し}まって います。",
            "vi": "Cửa ra vào đang đóng.",
            "audio": null
          }
        ]
      },
      {
        "id": "g2902",
        "pattern": "N は 自動詞て います",
        "vi": "Tả trạng thái của vật đang nói tới",
        "explain": "Dùng は khi vật đã được nêu hoặc khi muốn đối chiếu. Chọn tự động từ phù hợp với vật.",
        "viMistake": "Giấy rách dùng やぶれて. Cốc vỡ dùng われて.",
        "examples": [
          {
            "jp": "{青|あお}い コップは {割|わ}れて います。{白|しろ}い コップは {大丈夫|だいじょうぶ}です。",
            "vi": "Cốc xanh bị vỡ. Cốc trắng vẫn dùng được.",
            "audio": null
          }
        ]
      },
      {
        "id": "g2903",
        "pattern": "Vて しまいます／しまいました",
        "vi": "Làm cho xong hoặc đã làm xong hết",
        "explain": "V thể て + しまいます khi định làm cho xong. Dùng しまいました khi đã hoàn tất. Từ như ぜんぶ hoặc までに giúp nhận diện nghĩa.",
        "viMistake": "Cùng một dạng có thể chỉ sự cố. Xem mốc thời gian và ý của câu.",
        "examples": [
          {
            "jp": "{昼休|ひるやす}みまでに {書類|しょるい}を {片|かた}づけて しまいます。",
            "vi": "Tôi sẽ dọn xong giấy tờ trước giờ nghỉ trưa.",
            "audio": null
          }
        ]
      },
      {
        "id": "g2904",
        "pattern": "Vて しまいました",
        "vi": "Lỡ làm hoặc gặp việc đáng tiếc",
        "explain": "V thể て + しまいました diễn tả việc đã xảy ra, thường ngoài ý muốn trong ngữ cảnh sự cố. Kết hợp với bài 26 để giải thích bằng しまったんです.",
        "viMistake": "おとします → おとして. Dùng để nói mình làm rơi đồ.",
        "examples": [
          {
            "jp": "{帰|かえ}りに {自転車|じてんしゃ}の {鍵|かぎ}を {落|お}として しまいました。",
            "vi": "Trên đường về tôi lỡ làm rơi chìa khóa xe đạp.",
            "audio": null
          }
        ]
      }
    ],
