        "type": "dialogue",
        "title": "Hội thoại · Nhờ chuyển lời ở văn phòng",
        "reveal": true,
        "lines": [
          {
            "speaker": "An",
            "jp": "すみません、{森|もり}さんは いらっしゃいますか。",
            "vi": "Xin lỗi, anh Mori có ở đó không ạ?"
          },
          {
            "speaker": "Mai",
            "jp": "{今|いま}、{席|せき}を {外|はず}して います。",
            "vi": "Hiện anh ấy đang rời bàn làm việc."
          },
          {
