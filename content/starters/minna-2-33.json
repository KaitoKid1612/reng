    "grammar": [
      {
        "id": "g3301",
        "pattern": "Thể mệnh lệnh",
        "vi": "Nhận ra mệnh lệnh và lời cổ vũ",
        "explain": "Nhóm I đổi âm cuối sang hàng え. Nhóm II bỏ る, thêm ろ. する → しろ, くる → こい. Sắc thái mạnh, cần chọn theo ngữ cảnh.",
        "viMistake": "まもる → まもれ. Lời nhờ thông thường dùng 〜てください.",
        "examples": [
          {
            "jp": "{最後|さいご}まで {走|はし}れ！",
            "vi": "Chạy đến cùng!",
            "audio": null
          }
        ]
      },
      {
        "id": "g3302",
        "pattern": "V từ điển + な",
        "vi": "Nhận ra lệnh cấm",
        "explain": "Thêm な vào dạng từ điển của mọi nhóm. Dùng khi nhận diện khẩu lệnh hoặc nội quy.",
        "viMistake": "いくな nghĩa là đừng đi. Khi nhờ lịch sự, dùng いかないでください.",
        "examples": [
          {
            "jp": "ここで ボールを {投|な}げるな。",
            "vi": "Không được ném bóng ở đây.",
            "audio": null
          }
        ]
      },
      {
        "id": "g3303",
        "pattern": "何と読みますか／〜と読みます",
        "vi": "Hỏi và nói cách đọc",
        "explain": "Đặt cách đọc trước と. Có thể hỏi bằng なんと よみますか hoặc なんと よむんですか.",
        "viMistake": "なんと hỏi cách đọc. どういう いみ hỏi ý nghĩa.",
        "examples": [
          {
            "jp": "「{徐行|じょこう}」は なんと {読|よ}みますか。",
            "vi": "Chữ “徐行” đọc thế nào?",
            "audio": null
          }
        ]
      },
      {
        "id": "g3304",
        "pattern": "〜という意味です",
        "vi": "Giải thích ý nghĩa",
        "explain": "Đặt nội dung giải thích trước という意味です. Hỏi bằng どういう意味ですか.",
        "viMistake": "Khi giải thích biển báo, có thể diễn đạt nội dung bằng 〜てはいけません hoặc 〜てください.",
        "examples": [
          {
            "jp": "「{使用禁止|しようきんし}」は {使|つか}っては いけないという {意味|いみ}です。",
            "vi": "“使用禁止” có nghĩa là không được sử dụng.",
            "audio": null
          }
        ]
      },
      {
        "id": "g3305",
        "pattern": "〜と言っていました",
        "vi": "Thuật lại điều người khác nói",
        "explain": "Đặt nội dung được thuật lại ở thể thường trước と. Dùng だ với danh từ và tính từ な ở hiện tại khẳng định trong lời thuật gián tiếp.",
        "viMistake": "A đã nói B thì dùng Aさんが Bと いって いました.",
        "examples": [
          {
            "jp": "{田村|たむら}さんは {午後|ごご}に {戻|もど}ると {言|い}って いました。",
            "vi": "Anh Tamura nói chiều sẽ quay lại.",
            "audio": null
          }
        ]
      },
      {
        "id": "g3306",
        "pattern": "〜と伝えていただけませんか",
        "vi": "Nhờ chuyển lời lịch sự",
        "explain": "Nêu người nhận bằng に, rồi nội dung tin nhắn + と + 伝えていただけませんか.",
        "viMistake": "Người nhận lời nhắn và người mình đang nhờ có thể khác nhau.",
        "examples": [
          {
            "jp": "{森|もり}さんに {会議|かいぎ}は ２{時|じ}からだと {伝|つた}えて いただけませんか。",
            "vi": "Anh/chị nhắn giúp anh Mori là cuộc họp bắt đầu lúc 2 giờ được không ạ?",
            "audio": null
          }
        ]
      }
