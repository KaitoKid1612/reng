    "grammar": [
      {
        "id": "g3101",
        "pattern": "Thể ý chí · 意向形",
        "vi": "Rủ nhau làm hoặc tự nhủ sẽ làm",
        "explain": "Nhóm I đổi âm cuối sang hàng お và thêm う. Nhóm II bỏ る, thêm よう. する → しよう, くる → こよう.",
        "viMistake": "とる → とろう. よう đứng sau thân của động từ nhóm II, chẳng hạn うけよう.",
        "examples": [
          {
            "jp": "{帰|かえ}りに {本屋|ほんや}へ {寄|よ}ろう。",
            "vi": "Trên đường về ghé hiệu sách nhé.",
            "audio": null
          }
        ]
      },
      {
        "id": "g3102",
        "pattern": "V ý chí + と思います",
        "vi": "Nêu ý định, thường khi vừa quyết định",
        "explain": "Đặt thể ý chí trước と. Dùng と思います khi nêu điều mình quyết định, thường ngay trong tình huống nói.",
        "viMistake": "Muốn nói định viết thì dùng かこうと おもいます. かくと おもいます là nhận định rằng sẽ viết.",
        "examples": [
          {
            "jp": "この {講座|こうざ}は {面白|おもしろ}そうですね。{申|もう}し{込|こ}もうと {思|おも}います。",
            "vi": "Khóa này có vẻ hay. Tôi nghĩ mình sẽ đăng ký.",
            "audio": null
          }
        ]
      },
      {
        "id": "g3103",
        "pattern": "V ý chí + と思っています",
        "vi": "Nói dự định đã có từ trước",
        "explain": "Dùng khi một người đã nghĩ tới một việc và hiện vẫn giữ dự định. Khi nói thay người khác, dựa vào thông tin họ đã cho biết.",
        "viMistake": "Không dùng thể ます trước と trong mẫu này.",
        "examples": [
          {
            "jp": "{来年|らいねん}、{大学院|だいがくいん}で {経済学|けいざいがく}を {学|まな}ぼうと {思|おも}って います。",
            "vi": "Tôi định học kinh tế ở bậc cao học năm sau.",
            "audio": null
          }
        ]
      },
      {
        "id": "g3104",
        "pattern": "Vる／Vない + つもりです",
        "vi": "Nói ý định làm hoặc không làm",
        "explain": "Dùng thể từ điển cho ý định làm, thể ない cho ý định không làm. つもり cho biết điều chủ thể dự định.",
        "viMistake": "Nói định không dự thi: うけない つもりです.",
        "examples": [
          {
            "jp": "{今月|こんげつ}は {休|やす}みを {取|と}らない つもりです。",
            "vi": "Tôi định tháng này không xin nghỉ.",
            "audio": null
          }
        ]
      },
      {
        "id": "g3105",
        "pattern": "Vる／Nの + 予定です",
        "vi": "Nói lịch hoặc kế hoạch dự kiến",
        "explain": "Đặt thể từ điển hoặc danh từ + の trước 予定です. Dùng khi nói về lịch trình hay việc đã được sắp xếp.",
        "viMistake": "Danh từ cần の trong mẫu Nの予定です, chẳng hạn はっぴょうの よていです.",
        "examples": [
          {
            "jp": "{発表|はっぴょう}は {午後|ごご}２{時|じ}に {始|はじ}まる {予定|よてい}です。",
            "vi": "Phần trình bày dự kiến bắt đầu lúc 2 giờ chiều.",
            "audio": null
          }
        ]
      },
      {
        "id": "g3106",
        "pattern": "まだ + Vていません",
        "vi": "Nói việc đến nay vẫn chưa làm",
        "explain": "Thể て + いません và まだ cho biết việc chưa xảy ra hoặc chưa hoàn tất. Dùng để trả lời もう Vましたか.",
        "viMistake": "まだ もうしこんで いません cho biết chưa đăng ký. Ý định sau đó cần thêm câu riêng nếu muốn nói rõ.",
        "examples": [
          {
            "jp": "{入学試験|にゅうがくしけん}には まだ {申|もう}し{込|こ}んで いません。",
            "vi": "Tôi vẫn chưa đăng ký kỳ thi đầu vào.",
            "audio": null
          }
        ]
      }
    ],
