    "grammar": [
      {
        "id": "g0201",
        "pattern": "これ／それ／あれ は N です",
        "vi": "Cái này / đó / kia là N",
        "explain": "これ: vật gần người nói; それ: vật gần người nghe; あれ: vật xa cả hai. Hỏi: これは なんですか (Cái này là gì?).",
        "viMistake": "これ・それ・あれ đứng một mình, không đi kèm danh từ: không nói これ {本|ほん}.",
        "examples": [
          {
            "jp": "これは {本|ほん}です。",
            "vi": "Đây là quyển sách.",
            "audio": null
          },
          {
            "jp": "それは {辞書|じしょ}ですか。",
            "vi": "Đó có phải là từ điển không?",
            "audio": null
          },
          {
            "jp": "あれは なんですか。",
            "vi": "Kia là cái gì?",
            "audio": null
          }
        ]
      },
      {
        "id": "g0202",
        "pattern": "この／その／あの N",
        "vi": "N này / đó / kia",
        "explain": "この・その・あの luôn đứng trước danh từ: この {傘|かさ}, その かばん, あの {人|ひと}.",
        "viMistake": "この không đứng một mình: không nói このは; muốn nói “cái này” thì dùng これ.",
        "examples": [
          {
            "jp": "この {傘|かさ}は わたしのです。",
            "vi": "Cái ô này là của tôi.",
            "audio": null
          },
          {
            "jp": "その かばんは アンさんのです。",
            "vi": "Cái cặp đó là của An.",
            "audio": null
          },
          {
            "jp": "あの {人|ひと}は だれですか。",
            "vi": "Người kia là ai?",
            "audio": null
          }
        ]
      },
      {
        "id": "g0203",
        "pattern": "そうです／そうじゃ ありません",
        "vi": "Đúng vậy / Không phải vậy",
        "explain": "Trả lời câu hỏi danh từ 〜ですか: はい、そうです／いいえ、そうじゃ ありません. Có thể nói rõ hơn: いいえ、ちがいます。〜です.",
        "viMistake": "そうです chỉ dùng để xác nhận câu hỏi danh từ; câu hỏi lựa chọn (A ですか、B ですか) không trả lời bằng はい／いいえ.",
        "examples": [
          {
            "jp": "それは {辞書|じしょ}ですか。…はい、そうです。",
            "vi": "Đó là từ điển à? … Vâng, đúng vậy.",
            "audio": null
          },
          {
            "jp": "これは ボールペンですか。…いいえ、そうじゃ ありません。",
            "vi": "Đây là bút bi à? … Không, không phải.",
            "audio": null
          },
          {
            "jp": "シャープペンシルです。",
            "vi": "Đó là bút chì kim.",
            "audio": null
          }
        ]
      },
      {
        "id": "g0204",
        "pattern": "N1ですか、N2ですか",
        "vi": "Hỏi lựa chọn: N1 hay N2?",
        "explain": "Đặt hai câu hỏi liền nhau để hỏi chọn một trong hai. Trả lời bằng chính thứ được chọn.",
        "viMistake": "Không trả lời はい／いいえ cho câu hỏi lựa chọn; nói thẳng thứ được chọn: おちゃです.",
        "examples": [
          {
            "jp": "それは コーヒーですか、おちゃですか。",
            "vi": "Đó là cà phê hay trà?",
            "audio": null
          },
          {
            "jp": "おちゃです。",
            "vi": "Là trà.",
            "audio": null
          },
          {
            "jp": "これは「あ」ですか、「お」ですか。",
            "vi": "Đây là chữ “a” hay chữ “o”?",
            "audio": null
          }
        ]
      },
      {
        "id": "g0205",
        "pattern": "N1の N2 (なんの N／だれの N)",
        "vi": "N2 về N1, N2 của N1",
        "explain": "の còn chỉ nội dung (くるまの {雑誌|ざっし}: tạp chí về ô tô) và người sở hữu (わたしの {本|ほん}: sách của tôi). Hỏi: なんの 〜 (… về cái gì), だれの 〜 (… của ai). Khi đã rõ vật, có thể bỏ danh từ sau の: これは わたしのです.",
        "viMistake": "“Sách của tôi” là わたしの {本|ほん}: người sở hữu đứng trước, ngược với tiếng Việt.",
        "examples": [
          {
            "jp": "これは {日本語|にほんご}の {本|ほん}です。",
            "vi": "Đây là sách tiếng Nhật.",
            "audio": null
          },
          {
            "jp": "それは なんの {雑誌|ざっし}ですか。…{車|くるま}の {雑誌|ざっし}です。",
            "vi": "Đó là tạp chí về gì? … Tạp chí về ô tô.",
            "audio": null
          },
          {
            "jp": "この {時計|とけい}は だれのですか。…ナムさんのです。",
            "vi": "Cái đồng hồ này của ai? … Của Nam.",
            "audio": null
          }
        ]
      }
    ],
    "slides": [
      {
        "id": "s0201",
        "teacherNotes": "Khởi động: đặt vài đồ vật thật lên bàn (sách, bút, ô, điện thoại) và hỏi bằng tiếng Việt “cái này là gì?”. Bài đi theo trình tự bài 2 Minna no Nihongo Sơ cấp I.",
        "type": "title",
        "jp": "{第|だい}2{課|か}",
        "vi": "Đồ vật quanh mình: これ・それ・あれ"
      },
      {
        "id": "s0202",
        "type": "note",
        "title": "Mục tiêu buổi học",
        "body": "1. Chỉ vật: これ・それ・あれ, この・その・あの + danh từ\n2. Hỏi “cái gì”, “của ai”, “về cái gì”: なん, だれの, なんの\n3. Xác nhận: そうです／そうじゃ ありません\n4. Hỏi lựa chọn: A ですか、B ですか"
      },
      {
        "id": "s0203",
        "teacherNotes": "Dùng đồ vật thật: これ (trong tay mình), それ (trong tay người nghe), あれ (ở xa).",
        "type": "vocab",
        "refs": ["v0201", "v0202", "v0203", "v0204", "v0205", "v0206", "v0207", "v0208"]
      },
