    "grammar": [
      {
        "id": "g2801",
        "pattern": "V1 ながら V2",
        "vi": "Vừa làm việc này vừa làm việc kia",
        "explain": "Lấy thân V1 trước ます + ながら. Cùng người làm cả hai việc. V2 là việc chính và quyết định thì của câu.",
        "viMistake": "ききます → ききながら. Tránh dùng きくながら.",
        "examples": [
          {
            "jp": "{景色|けしき}を {見|み}ながら バスで {会社|かいしゃ}に {通|かよ}っています。",
            "vi": "Tôi thường đi xe buýt đến công ty và ngắm cảnh trên đường.",
            "audio": null
          },
          {
            "jp": "{先生|せんせい}の {話|はなし}を {聞|き}きながら メモしました。",
            "vi": "Tôi vừa nghe giáo viên nói vừa ghi chú.",
            "audio": null
          }
        ]
      },
      {
        "id": "g2802",
        "pattern": "Vて います／いました",
        "vi": "Kể thói quen hiện tại hoặc trước đây",
        "explain": "Dùng Vて います cho việc lặp thường xuyên. Dùng Vて いました khi kể thói quen trong quá khứ. Dựa vào mốc như まいあさ hoặc まえは để nhận diện.",
        "viMistake": "いま có thể chỉ hành động đang diễn ra. まいしゅう thường gợi cách hiểu theo thói quen.",
        "examples": [
          {
            "jp": "{毎週|まいしゅう}、{娘|むすめ}と {図書館|としょかん}に {通|かよ}っています。",
            "vi": "Tuần nào tôi cũng đến thư viện cùng con gái.",
            "audio": null
          },
          {
            "jp": "{前|まえ}は {毎朝|まいあさ} {駅|えき}まで {歩|ある}いて いました。",
            "vi": "Trước đây sáng nào tôi cũng đi bộ đến ga.",
            "audio": null
          }
        ]
      },
      {
        "id": "g2803",
        "pattern": "〜し、〜し",
        "vi": "Liệt kê đặc điểm hoặc lý do",
        "explain": "Thể thường + し. Danh từ và tính từ な ở hiện tại khẳng định dùng だし. Có thể dùng も khi nêu đặc điểm song song.",
        "viMistake": "Dùng まじめだし、がくせいだし. Tính từ い dùng やすいし.",
        "examples": [
          {
            "jp": "この パンは {形|かたち}も おもしろいし、{味|あじ}も いいです。",
            "vi": "Bánh mì này có hình thú vị và vị cũng ngon.",
            "audio": null
          },
          {
            "jp": "{姉|あね}は {小説家|しょうせつか}だし、{会話|かいわ}も {上手|じょうず}です。",
            "vi": "Chị tôi vừa là nhà văn vừa nói chuyện rất khéo.",
            "audio": null
          }
        ]
      },
      {
        "id": "g2804",
        "pattern": "〜し、〜し、結論",
        "vi": "Đưa ra nhiều lý do cho một kết luận",
        "explain": "Có thể đặt kết luận sau các lý do. Khi trả lời どうして, có thể kết thúc bằng lý do cuối + からです. Một vế し có thể ngụ ý còn lý do khác.",
        "viMistake": "Ở sau danh từ và tính từ な, dùng だからです khi kết thúc bằng lý do.",
        "examples": [
          {
            "jp": "この {店|みせ}は {品物|しなもの}が {多|おお}いし、{値段|ねだん}も {安|やす}いし、よく {来|き}ます。",
            "vi": "Cửa hàng này nhiều hàng, giá lại rẻ nên tôi thường đến.",
            "audio": null
          },
          {
            "jp": "{駅|えき}から {近|ちか}いし、{静|しず}かだからです。",
            "vi": "Vì gần ga và cũng yên tĩnh.",
            "audio": null
          }
        ]
      },
      {
        "id": "g2805",
        "pattern": "それに／それで",
        "vi": "Thêm ý hoặc nối sang kết quả",
        "explain": "それに thêm một đặc điểm hoặc lý do. それで dẫn sang sự việc xảy ra do tình huống đã nêu.",
        "viMistake": "Thêm vế «giá cũng rẻ» dùng それに. Nói «vì thế tôi đã mua» dùng それで.",
        "examples": [
          {
            "jp": "この {部屋|へや}は {明|あか}るいです。それに、{台所|だいどころ}も {広|ひろ}いです。",
            "vi": "Phòng này sáng. Hơn nữa, bếp cũng rộng.",
            "audio": null
          },
          {
            "jp": "バスが {来|き}ませんでした。それで、{駅|えき}まで {歩|ある}きました。",
            "vi": "Xe buýt không đến. Vì thế tôi đã đi bộ đến ga.",
            "audio": null
          }
        ]
      },
      {
        "id": "g2806",
        "pattern": "〜ときに／〜ときは",
        "vi": "Chỉ thời điểm hoặc nêu hoàn cảnh",
        "explain": "とき tạo một cụm thời gian. に đánh dấu lúc xảy ra sự việc. は đưa hoàn cảnh lên làm chủ đề, thường gặp khi nói thói quen hoặc đối chiếu.",
        "viMistake": "Khi muốn nhấn thói quen lúc rảnh, có thể dùng ひまな ときは. Trước とき, tính từ な giữ な.",
        "examples": [
          {
            "jp": "この {写真|しゃしん}は {旅行|りょこう}した ときに {撮|と}りました。",
            "vi": "Tôi chụp ảnh này khi đi du lịch.",
            "audio": null
          },
          {
            "jp": "{休|やす}みの ときは たいてい {小説|しょうせつ}を {読|よ}んで います。",
            "vi": "Ngày nghỉ tôi thường đọc tiểu thuyết.",
            "audio": null
          }
        ]
      }
    ],
