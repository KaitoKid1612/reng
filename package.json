{
  "name": "reng",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test",
    "format": "prettier --write app components lib scripts tests e2e e2e-supabase content *.ts *.mjs *.json .prettierrc.json README.md",
    "format:check": "prettier --check app components lib scripts tests e2e e2e-supabase content *.ts *.mjs *.json .prettierrc.json README.md",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:supabase": "playwright test -c playwright.supabase.config.ts",
    "audit:layout": "node --import tsx scripts/audit-layout.ts",
    "audit:jlpt-audio": "node --import tsx scripts/audit-jlpt-audio.ts",
    "validate:data": "node --import tsx scripts/validate-data.ts",
    "audio:plan": "node --env-file-if-exists=.env.local --import tsx scripts/generate-audio.ts",
    "audio:generate": "node --env-file-if-exists=.env.local --import tsx scripts/generate-audio.ts --generate",
    "lesson:import": "node --env-file-if-exists=.env.local --import tsx scripts/import-lesson.ts",
    "daily:import": "node --import tsx scripts/import-daily-sheet.ts",
    "bank:sql": "node --import tsx scripts/review-bank-sql.ts",
    "furigana:sql": "node --import tsx scripts/furigana-snapshot-sql.ts",
    "listening:sql": "node --env-file-if-exists=.env.local --import tsx scripts/listening-draft-sql.ts",
    "listening:merge": "node --import tsx scripts/merge-daily-listening.ts",
    "jlpt:drafts": "node --import tsx scripts/jlpt-drafts.ts",
    "seed:local": "node --env-file-if-exists=.env.local --import tsx scripts/seed-local.ts",
    "seed:demo": "node --env-file-if-exists=.env.local --import tsx scripts/seed-demo.ts",
    "admin:grant": "node --env-file-if-exists=.env.local --import tsx scripts/grant-admin.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1161.0",
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@fontsource/be-vietnam-pro": "5.3.0",
    "@fontsource/klee-one": "5.3.1",
    "@fontsource/noto-sans-jp": "5.3.1",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.67.0",
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "reveal.js": "6.0.2",
    "server-only": "0.0.1",
    "tailwind-merge": "3.7.0",
    "ts-fsrs": "5.4.2",
    "wanakana": "5.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.15",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.4",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.5",
    "prettier": "3.9.10",
    "supabase": "2.122.0",
    "tailwindcss": "4.3.4",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  }
}
